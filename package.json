{
  "name": "aws-practitioner-backend",
  "version": "0.1.0",
  "bin": {
    "aws-practitioner-backend": "bin/aws-practitioner-backend.js"
  },
  "scripts": {
    "build": "./node_modules/.bin/tsc",
    "watch": "./node_modules/.bin/tsc -w",
    "test": "jest",
    "cdk": "./node_modules/.bin/cdk",
    "cdk:deploy": "npm run build && ./node_modules/.bin/cdk deploy --require-approval never --all",
    "seed": "npm run build && node dist/scripts/seed-dynamodb.js"
  },
  "devDependencies": {
    "@types/jest": "^30",
    "@types/node": "^24.12.2",
    "aws-cdk": "2.1117.0",
    "esbuild": "^0.28.0",
    "jest": "^30",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1033.0",
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/lib-dynamodb": "^3.1033.0",
    "@aws-sdk/s3-request-presigner": "^3.1038.0",
    "@types/aws-lambda": "^8.10.161",
    "aws-cdk-lib": "^2.247.0",
    "aws-lambda": "^1.0.7",
    "constructs": "^10.5.0",
    "csv-parser": "^3.2.0"
  }
}
